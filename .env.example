# Server
PORT=8000
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Local default:
DATABASE_URL=sqlite+aiosqlite:///./docflow.db
# Cloud example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB

# Target portal (no student credentials here)
FUW_PORTAL_URL=https://ug.fuwportal.edu.ng/index.php

# Optional operator bootstrap (only used if both are set)
ADMIN_EMAIL=
ADMIN_FULL_NAME=DocFlow Administrator
ADMIN_PASSWORD=

# CORS — comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Cloudinary for durable PDF storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PDF storage (relative path; created automatically)
STORAGE_DIR=./storage/pdfs

# Public student printer abuse controls
ALLOW_PUBLIC_REGISTER=True
AUTO_GENERATE_RATE_LIMIT=8
AUTO_GENERATE_RATE_WINDOW_SECONDS=600

# Frontend (used by Next.js rewrites in local/docker)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_FALLBACK_URL=https://docflow-automator-backend.onrender.com/api/v1
